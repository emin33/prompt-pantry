---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import RecipeFilter from "../../components/RecipeFilter";

const recipes = await getCollection(
  "recipes",
  ({ data }) => data.published && !data.variantOf && data.category === "Beverage"
);

const recipeData = recipes.map((r) => ({
  title: r.data.title,
  slug: r.data.slug,
  description: r.data.description,
  cuisine: r.data.cuisine,
  category: r.data.category,
  difficulty: r.data.difficulty,
  totalTime: r.data.totalTime,
  tags: r.data.tags,
  publishedDate: r.data.publishedDate,
  image: r.data.image,
  source: r.data.source,
}));
---

<Layout title="Drinks" description="Cocktails, slushes, and sips from the Prompt Pantry bar.">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <h1 class="font-display text-4xl md:text-5xl text-charcoal mb-2">Drinks</h1>
    <p class="text-warm-gray mb-8">
      The Prompt Pantry bar — cocktails, slushes, and sips to go with dinner.
    </p>
    <RecipeFilter client:load recipes={recipeData} defaultSource="" />
  </div>
</Layout>
